# Hybrid-linked smartdns for linux/amd64 (musl)
# Static: libssl, libcrypto, libcurl  |  Dynamic: musl libc + ld-musl
# UI plugin (smartdns_ui.so) loads via dlopen() — works out of the box.
#
# Prerequisite: Build the base builder image ONCE:
#   docker buildx build -f Dockerfile.builder-base --platform linux/amd64 \
#     --load -t smartdns-builder-x86_64-base .
#
# Then build (~2 min):
#   docker buildx build -f Dockerfile.hybrid-x86_64 --platform linux/amd64 \
#     --load -t smartdns-hybrid-x86_64 .

FROM smartdns-builder-x86_64-base AS builder

# Source code
COPY Makefile /build/Makefile
COPY src/ /build/src/
COPY plugin/ /build/plugin/
COPY systemd/ /build/systemd/
COPY etc/ /build/etc/

# Install patchelf for post-processing .so DT_NEEDED entries
RUN apk add --no-cache patchelf

# Build: STATIC_DEPS=1 → static ssl/curl, dynamic libc (for dlopen plugin)
RUN cd /build && \
    echo "=== Building smartdns (hybrid) ===" && \
    make clean && make WITH_UI=1 OPTIMIZE_SIZE=1 STATIC_DEPS=1 -j$(nproc) 2>&1 | tail -30 && \
    echo "=== Done ==="

# Verify outputs
RUN echo "=== Binary info ===" && \
    ls -lh /build/src/smartdns && file /build/src/smartdns && \
    echo "=== main NEEDED (should be empty) ===" && \
    (x86_64-alpine-linux-musl-readelf -d /build/src/smartdns 2>/dev/null | grep NEEDED || true) && \
    echo "=== UI Plugin ===" && \
    ls -lh /build/plugin/smartdns-ui/target/smartdns_ui.so && \
    file /build/plugin/smartdns-ui/target/smartdns_ui.so && \
    echo "=== plugin .so NEEDED (should have NO libgcc_s) ===" && \
    x86_64-alpine-linux-musl-readelf -d /build/plugin/smartdns-ui/target/smartdns_ui.so 2>/dev/null | grep NEEDED; true && \
    echo "=== OK ==="

# --- Export stage: output to host filesystem via --output ---
FROM scratch AS export
COPY --from=builder /build/src/smartdns /smartdns
COPY --from=builder /build/plugin/smartdns-ui/target/smartdns_ui.so /smartdns_ui.so
