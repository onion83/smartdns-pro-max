# Pre-built builder base for linux/arm64 (aarch64, musl) static compilation.
# Contains: C toolchain, Rust (rustup + musl-target + bindgen), static OpenSSL, static libcurl.
#
# Build ONCE (takes ~5 min):
#   docker buildx build -f Dockerfile.builder-base-arm64 --platform linux/arm64 \
#     -t smartdns-builder-arm64-base .

FROM --platform=linux/arm64 alpine:3.19 AS base

# --- C build tools ---
RUN apk add --no-cache \
    build-base \
    linux-headers \
    musl-dev \
    zlib-static \
    pkgconf \
    git \
    curl \
    ca-certificates \
    perl

# --- Rust toolchain (rustup + musl target + bindgen) ---
RUN apk add --no-cache \
    llvm15-dev \
    clang \
    clang15-dev && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && \
    . /root/.cargo/env && \
    rustup target add aarch64-unknown-linux-musl && \
    cargo install bindgen-cli 2>&1 | tail -3 && \
    echo "=== Base ready ===" && rustc --version && cargo version

# --- Static OpenSSL (installed to /opt/openssl) ---
COPY third_party/build_openssl.sh /tmp/build_openssl.sh
RUN chmod +x /tmp/build_openssl.sh && \
    LOCAL_OPENSSL_INSTALL=/opt/openssl /tmp/build_openssl.sh && \
    rm -f /tmp/build_openssl.sh && \
    ls /opt/openssl/lib*/lib*.a 2>/dev/null || false && \
    ln -sf /opt/openssl/lib64 /opt/openssl/lib 2>/dev/null || true

# --- Static libcurl (linked against static OpenSSL) ---
COPY third_party/build_curl.sh /tmp/build_curl.sh
RUN chmod +x /tmp/build_curl.sh && \
    export LIBS="-ldl -lpthread" && \
    LOCAL_CURL_INSTALL=/opt/curl \
    LOCAL_OPENSSL_INSTALL=/opt/openssl \
    /tmp/build_curl.sh && \
    rm -f /tmp/build_curl.sh

# --- Persistent env for all child images ---
ENV LOCAL_CURL_DIR=/opt/curl
ENV LOCAL_OPENSSL_DIR=/opt/openssl
ENV NO_GIT_VER=1
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Verify all pre-built deps exist
RUN echo "=== Builder base verification ===" && \
    echo "OpenSSL:" && ls -lh /opt/openssl/lib/libcrypto.a /opt/openssl/lib/libssl.a && \
    echo "libcurl:" && ls -lh /opt/curl/lib/libcurl.a && \
    echo "Rust:" && rustc --version && cargo version && bindgen --version && \
    echo "=== Base OK ==="
