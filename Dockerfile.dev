FROM ubuntu:22.04

LABEL maintainer="smartdns"
LABEL description="SmartDNS development environment"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install development tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libgtest-dev \
    cmake \
    dnsutils \
    make \
    git \
    curl \
    vim \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /smartdns

# Default command
CMD ["/bin/bash"]
